test "every word gives one capital" {
    var letters: Letters = attempt initials.of("Grace Brewster Murray Hopper")
    assert letters == "GBMH"
}

test "one word gives one letter" {
    var letters: Letters = attempt initials.of("cher")
    assert letters == "C"
}

test "dotted initials end each letter with a full stop" {
    var letters: Letters = attempt initials.dotted("John Ronald Reuel Tolkien")
    assert letters == "J.R.R.T."
}
